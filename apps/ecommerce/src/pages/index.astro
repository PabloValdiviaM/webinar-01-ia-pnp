            Despliegue unificado en un solo contenedor Docker multi-stage con compilación instantánea de Astro, React y Node.js en 25 segundos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner to PWA -->
  <section id="experiencia" class="container">
    <div class="cta-banner">
      <h2 class="cta-title">¿Listo para Saborear o Aprender la Receta?</h2>
      <p class="cta-desc">
        Ingresa a nuestra aplicación móvil PWA para simular la compra de cualquiera de nuestras 4 hamburguesas maestras con promociones exclusivas.
      </p>
      <div class="cta-buttons">
        <a href="/app" class="btn-primary">
          <span>📲</span> Abrir PWA Mobile (/app)
        </a>
        <a href="/admin" class="btn-secondary">
          <span>⚙️</span> Panel de Administración (/admin)
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Detail Modal -->
  <div id="detailModal" class="modal-backdrop">
    <div class="modal-box">
      <div class="modal-header">
        <img id="modalImg" src="" alt="Burger Detail" class="modal-header-img" />
        <button id="modalClose" class="modal-close-btn" aria-label="Cerrar modal">&times;</button>
      </div>

      <div class="modal-body">
        <div class="modal-meta">
          <span id="modalLevel" class="modal-pill"></span>
          <span id="modalDuration" style="font-size:0.8rem; color:#94a3b8; font-weight:600;"></span>
        </div>

        <h3 id="modalTitle" class="modal-title"></h3>
        <div id="modalChef" class="modal-chef"></div>
        <p id="modalDesc" class="modal-desc"></p>

        <div class="modal-section-title">Contenido del Curso & Técnicas Culinarias</div>
        <ul id="modalHighlights" class="modal-list"></ul>

        <div style="background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.25); border-radius: 12px; padding: 12px 16px; margin-bottom: 20px;">
          <div style="font-size: 0.8rem; color: #38bdf8; font-weight: 800; text-transform: uppercase;">Material Incluido</div>
          <div id="modalIncludes" style="font-size: 0.88rem; color: #e2e8f0; margin-top: 4px;"></div>
        </div>

        <div class="modal-actions">
          <div style="display: flex; flex-direction: column;">
            <span id="modalOrigPrice" style="text-decoration: line-through; font-size: 0.85rem; color: #64748b;"></span>
            <span id="modalPrice" style="font-size: 1.8rem; font-weight: 900; color: #38bdf8;"></span>
          </div>

          <div style="margin-left: auto; display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="/app" class="btn-primary" style="padding: 0.75rem 1.4rem; font-size: 0.95rem;">
              <span>🍔</span> Pedir en App PWA
            </a>
            <button id="btnModalEnroll" class="btn-secondary" style="padding: 0.75rem 1.4rem; font-size: 0.95rem;">
              <span>🎓</span> Inscribirme Ahora
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
            <span style="font-size:1.6rem;">🔥</span>
            <span style="font-size:1.2rem; font-weight:800; color:white;">NextCollege Rapid</span>
          </div>
          <p style="color:#94a3b8; font-size:0.9rem; max-width:360px; line-height:1.6;">
            Plataforma comercial y académica de alta velocidad. Formación culinaria gourmet, pedidos móviles progresivos y gestión analítica para negocios de comida rápida.
          </p>
        </div>

        <div class="footer-col">
          <h4>Plataforma & Apps</h4>
          <ul>
            <li><a href="/">🌐 E-commerce Portal</a></li>
            <li><a href="/app">📱 PWA Mobile (/app)</a></li>
            <li><a href="/admin">⚙️ Panel Admin (/admin)</a></li>
            <li><a href="/api/health">🩺 Health Check API</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Hamburguesas Top</h4>
          <ul>
            <li><a href="#cursos">Rey de las hamburguesas a la parrilla</a></li>
            <li><a href="#cursos">Hamburguesa Real</a></li>
            <li><a href="#cursos">Hamburguesa Royal Crispy</a></li>
            <li><a href="#cursos">HamburguesaDouble Whopper</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        &copy; {new Date().getFullYear()} NextCollege Rapid &bull; Todos los derechos reservados. Desarrollado con Astro, React, Node.js y MySQL sobre Dokploy.
      </div>
    </div>
  </footer>

  <!-- Modal Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('detailModal');
      const modalClose = document.getElementById('modalClose');
      const modalImg = document.getElementById('modalImg');
      const modalLevel = document.getElementById('modalLevel');
      const modalDuration = document.getElementById('modalDuration');
      const modalTitle = document.getElementById('modalTitle');
      const modalChef = document.getElementById('modalChef');
      const modalDesc = document.getElementById('modalDesc');
      const modalHighlights = document.getElementById('modalHighlights');
      const modalIncludes = document.getElementById('modalIncludes');
      const modalPrice = document.getElementById('modalPrice');
      const modalOrigPrice = document.getElementById('modalOrigPrice');
      const btnModalEnroll = document.getElementById('btnModalEnroll');

      // Open Modal
      document.querySelectorAll('.btn-detail').forEach(btn => {
        btn.addEventListener('click', () => {
          const name = btn.getAttribute('data-name');
          const level = btn.getAttribute('data-level');
          const levelColor = btn.getAttribute('data-level-color');
          const price = parseFloat(btn.getAttribute('data-price')).toFixed(2);
          const origPrice = parseFloat(btn.getAttribute('data-orig-price')).toFixed(2);
          const img = btn.getAttribute('data-img');
          const desc = btn.getAttribute('data-desc');
          const duration = btn.getAttribute('data-duration');
          const chef = btn.getAttribute('data-chef');
          const includes = btn.getAttribute('data-includes');
          const highlights = JSON.parse(btn.getAttribute('data-highlights') || '[]');

          modalImg.src = img;
          modalTitle.textContent = name;
          modalLevel.textContent = level;
          modalLevel.style.background = levelColor + '25';
          modalLevel.style.color = levelColor;
          modalLevel.style.border = `1px solid ${levelColor}60`;
          modalDuration.textContent = '⏱️ ' + duration;
          modalChef.textContent = '👨‍🍳 Instructor: ' + chef;
          modalDesc.textContent = desc;
          modalPrice.textContent = '$' + price + ' USD';
          modalOrigPrice.textContent = '$' + origPrice + ' USD';
          modalIncludes.textContent = includes;

          modalHighlights.innerHTML = '';
          highlights.forEach(h => {
            const li = document.createElement('li');
            li.innerHTML = `<span>✓</span> ${h}`;
            modalHighlights.appendChild(li);
          });

          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
      });

      if (btnModalEnroll) {
        btnModalEnroll.addEventListener('click', () => {
          alert('¡Inscripción simulada con éxito! Puedes ordenar esta hamburguesa directamente en nuestra app móvil (/app).');
          window.location.href = '/app';
        });
      }
    });
  </script>
</body>
</html>
