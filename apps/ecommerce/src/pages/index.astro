---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="NextCollege Rapid: Formación culinaria de élite para negocios de comida rápida y catálogo exclusivo de hamburguesas gourmet a la parrilla." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #090d16;
      --bg-surface: #0f172a;
      --card: #131b2e;
      --card-hover: #17223b;
      --border: #1e293b;
      --border-accent: #334155;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --amber: #f59e0b;
      --emerald: #10b981;
      --flame: #ef4444;
      --cyan: #38bdf8;
      --radius: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.6;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(37, 99, 235, 0.12) 0%, transparent 40%),
        radial-gradient(circle at 85% 35%, rgba(245, 158, 11, 0.09) 0%, transparent 45%),
        radial-gradient(circle at 50% 85%, rgba(239, 68, 68, 0.08) 0%, transparent 50%);
      background-attachment: fixed;
    }

    /* Container */
    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Navbar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(9, 13, 22, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 1rem 0;
    }
    .nav-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: white;
    }
    .brand-icon {
      font-size: 1.8rem;
      background: linear-gradient(135deg, #f59e0b, #ef4444);
      padding: 0.25rem 0.5rem;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
    }
    .brand-text {
      font-weight: 800;
      font-size: 1.3rem;
      letter-spacing: -0.02em;
    }
    .brand-sub {
      color: var(--amber);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      display: block;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
    }
    .nav-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.2s;
    }
    .nav-link:hover {
      color: white;
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .btn-pwa {
      background: linear-gradient(135deg, #2563eb, #38bdf8);
      color: white;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 0.6rem 1.1rem;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    }
    .btn-pwa:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.6);
    }
    .btn-admin {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      padding: 0.6rem 1rem;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s;
    }
    .btn-admin:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--cyan);
    }

    /* Hero Section */
    .hero {
      padding: 4.5rem 0 3.5rem;
      text-align: center;
      position: relative;
    }
    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fbbf24;
      padding: 0.5rem 1.25rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1.75rem;
      animation: pulseGlow 3s infinite;
    }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 15px rgba(245, 158, 11, 0.2); }
      50% { box-shadow: 0 0 25px rgba(245, 158, 11, 0.4); }
    }
    .hero-title {
      font-size: clamp(2.3rem, 5.5vw, 4.2rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
      max-width: 950px;
      margin-left: auto;
      margin-right: auto;
      background: linear-gradient(135deg, #ffffff 30%, #e2e8f0 70%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-title .highlight {
      background: linear-gradient(135deg, #f59e0b, #ef4444);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-description {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: var(--text-muted);
      max-width: 720px;
      margin: 0 auto 2.5rem;
      line-height: 1.7;
    }
    .hero-buttons {
      display: flex;
      justify-content: center;
      gap: 1.2rem;
      flex-wrap: wrap;
      margin-bottom: 3.5rem;
    }
    .btn-primary {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #0f172a;
      text-decoration: none;
      font-weight: 800;
      font-size: 1.05rem;
      padding: 0.95rem 2rem;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      transition: all 0.25s ease;
      box-shadow: 0 10px 25px rgba(245, 158, 11, 0.35);
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 35px rgba(245, 158, 11, 0.5);
      filter: brightness(1.08);
    }
    .btn-secondary {
      background: var(--card);
      border: 1px solid var(--border);
      color: white;
      text-decoration: none;
      font-weight: 700;
      font-size: 1.05rem;
      padding: 0.95rem 1.8rem;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      transition: all 0.25s;
    }
    .btn-secondary:hover {
      border-color: var(--primary);
      background: var(--card-hover);
      transform: translateY(-2px);
    }

    /* Stats bar */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.25rem;
      background: rgba(19, 27, 46, 0.7);
      border: 1px solid var(--border);
      padding: 1.75rem 2rem;
      border-radius: var(--radius);
      backdrop-filter: blur(8px);
      max-width: 1050px;
      margin: 0 auto;
    }
    .stat-item {
      text-align: center;
    }
    .stat-number {
      font-size: 1.9rem;
      font-weight: 900;
      color: white;
      letter-spacing: -0.02em;
    }
    .stat-label {
      color: var(--text-muted);
      font-size: 0.85rem;
      font-weight: 600;
      margin-top: 0.25rem;
    }

    /* Section Headers */
    .section-header {
      text-align: center;
      margin-bottom: 3.5rem;
    }
    .section-tag {
      color: var(--cyan);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.75rem;
      display: inline-block;
    }
    .section-title {
      font-size: clamp(2rem, 3.5vw, 2.8rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
      color: white;
    }
    .section-subtitle {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 650px;
      margin: 0 auto;
    }

    /* Catalog Cards Grid */
    .catalog-section {
      padding: 5rem 0;
    }
    .courses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }
    .course-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }
    .course-card:hover {
      transform: translateY(-8px);
      border-color: rgba(56, 189, 248, 0.4);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(37, 99, 235, 0.15);
    }
    .card-image-wrap {
      position: relative;
      height: 220px;
      overflow: hidden;
      background: #000;
    }
    .card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }
    .course-card:hover .card-image {
      transform: scale(1.08);
    }
    .badge-level {
      position: absolute;
      top: 1rem;
      left: 1rem;
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(8px);
      padding: 0.4rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
    .card-rating {
      position: absolute;
      bottom: 0.75rem;
      right: 0.75rem;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(6px);
      padding: 0.3rem 0.65rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      color: #fbbf24;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .card-content {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .course-name {
      font-size: 1.35rem;
      font-weight: 800;
      color: white;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }
    .course-desc {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      flex: 1;
    }
    .card-footer {
      border-top: 1px solid rgba(255, 255, 255, 0.07);
      padding-top: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .price-wrap {
      display: flex;
      flex-direction: column;
    }
    .price-original {
      font-size: 0.8rem;
      color: #64748b;
      text-decoration: line-through;
      font-weight: 600;
    }
    .price-current {
      font-size: 1.55rem;
      font-weight: 900;
      color: #38bdf8;
      letter-spacing: -0.02em;
    }
    .btn-detail {
      background: rgba(37, 99, 235, 0.15);
      border: 1px solid rgba(37, 99, 235, 0.4);
      color: #93c5fd;
      padding: 0.65rem 1.25rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .btn-detail:hover {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
    }

    /* Modal Styling */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(3, 7, 18, 0.85);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 1.5rem;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .modal-backdrop.active {
      display: flex;
      opacity: 1;
    }
    .modal-box {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 20px;
      max-width: 680px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8);
      position: relative;
      animation: modalSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes modalSlideUp {
      from { transform: translateY(20px) scale(0.97); }
      to { transform: translateY(0) scale(1); }
    }
    .modal-header {
      position: relative;
      height: 220px;
      overflow: hidden;
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
    }
    .modal-header-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .modal-close-btn {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: white;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .modal-close-btn:hover {
      background: var(--flame);
      transform: rotate(90deg);
    }
    .modal-body {
      padding: 2rem;
    }
    .modal-meta {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .modal-pill {
      font-size: 0.75rem;
      font-weight: 800;
      padding: 0.3rem 0.8rem;
      border-radius: 9999px;
      text-transform: uppercase;
    }
    .modal-title {
      font-size: 1.8rem;
      font-weight: 900;
      color: white;
      margin-bottom: 0.75rem;
    }
    .modal-chef {
      color: #38bdf8;
      font-weight: 700;
      font-size: 0.95rem;
      margin-bottom: 1.25rem;
    }
    .modal-desc {
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .modal-section-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.75rem;
    }
    .modal-list {
      list-style: none;
      display: grid;
      gap: 0.6rem;
      margin-bottom: 1.75rem;
    }
    .modal-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      color: #cbd5e1;
      font-size: 0.92rem;
    }
    .modal-list li span {
      color: var(--emerald);
      font-weight: 800;
    }
    .modal-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
      border-top: 1px solid #1f2937;
      padding-top: 1.5rem;
      flex-wrap: wrap;
    }

    /* Platform Architecture Feature Grid */
    .features-section {
      padding: 4.5rem 0;
      background: rgba(15, 23, 42, 0.4);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .feature-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }
    .feature-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem 1.75rem;
      transition: all 0.25s;
    }
    .feature-card:hover {
      border-color: var(--primary);
      transform: translateY(-4px);
    }
    .feature-icon {
      font-size: 2.2rem;
      margin-bottom: 1.2rem;
      display: inline-block;
    }
    .feature-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: white;
      margin-bottom: 0.75rem;
    }
    .feature-desc {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.6;
    }

    /* PWA Banner CTA */
    .cta-banner {
      margin: 5rem auto;
      background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
      border: 1px solid #3730a3;
      border-radius: 24px;
      padding: 3.5rem 2.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }
    .cta-title {
      font-size: clamp(1.8rem, 3.5vw, 2.5rem);
      font-weight: 900;
      color: white;
      margin-bottom: 1rem;
    }
    .cta-desc {
      color: #cbd5e1;
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto 2rem;
    }
    .cta-buttons {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    /* Footer */
    footer {
