              <img src={course.image} alt={course.name} class="card-image" loading="lazy" />
              <span class="badge-level" style={`color: ${course.badgeColor}; border-color: ${course.badgeColor}40;`}>
                {course.badgeLevel}
              </span>
              <div class="card-rating">
                ★ <span>{course.rating}</span> ({course.reviewsCount})
              </div>
            </div>

            <div class="card-content">
              <h3 class="course-name">{course.name}</h3>
              <p class="course-desc">{course.description}</p>

              <div class="card-footer">
                <div class="price-wrap">
                  <span class="price-original">${course.originalPrice.toFixed(2)} USD</span>
                  <span class="price-current">${course.price.toFixed(2)} <span style="font-size: 0.85rem; color: #94a3b8; font-weight: normal;">USD</span></span>
                </div>

                <button 
                  class="btn-detail" 
                  data-course-id={course.id}
                  data-name={course.name}
                  data-level={course.badgeLevel}
                  data-level-color={course.badgeColor}
                  data-price={course.price}
                  data-orig-price={course.originalPrice}
                  data-img={course.image}
                  data-desc={course.description}
                  data-duration={course.duration}
                  data-chef={course.chef}
                  data-includes={course.includes}
                  data-highlights={JSON.stringify(course.highlights)}
